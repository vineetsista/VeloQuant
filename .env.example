# Copy this to .env and fill in your values.
# NEVER commit .env to git.

# Database — Railway sets this automatically when you add the Postgres plugin
DATABASE_URL=postgresql://user:password@host/dbname

# AI
ANTHROPIC_API_KEY=sk-ant-...

# Market data (polygon.io — free tier works)
POLYGON_API_KEY=PA_...

# Email (sendgrid.com)
SENDGRID_API_KEY=SG....
BRIEFING_FROM_EMAIL=you@yourdomain.com

# Stripe — use TEST keys locally, LIVE keys in production
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# App
APP_URL=https://your-app.up.railway.app
ADMIN_EMAIL=your@email.com
